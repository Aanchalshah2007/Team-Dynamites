# Copy to .env and fill in real values. Never commit the filled file.

# --- LiveKit (WebRTC transport for the voice agent) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech-to-text ---
DEEPGRAM_API_KEY=

# --- LLM (turn reasoning, SQL generation, answer formatting) ---
# Groq's OpenAI-compatible API by default.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Rime TTS ---
RIME_API_KEY=
# Exact combination actually tested end-to-end before submission.
# See architecture/architechture.md §3 and RIME_EVIDENCE.md.
RIME_MODEL_ID=mistv2
RIME_SPEAKER=abbie
RIME_LANGUAGE=eng
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLE_RATE=16000

# --- Firebase (Firestore telemetry: fenced_drop events, active_speech_provider, dashboard) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
